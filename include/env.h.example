// Copiez ce fichier en `env.h` et renseignez les valeurs.
//
// `env.h` est ignoré par git : les identifiants ne doivent jamais partir
// dans le dépôt. Sans ce fichier, le firmware ne compile pas, et c'est
// voulu : un oubli se voit au build plutôt qu'en production.

#ifndef ENV_H
#define ENV_H

// Point d'accès ouvert au premier démarrage, le temps de donner au module
// le réseau qu'il doit rejoindre.
#define ESP_WIFI_SSID     "WifiManager-MicroCoaster"
#define ESP_WIFI_PASSWORD "<mot de passe du portail, 8 caracteres minimum>"

// Identité du module auprès du serveur. Le mot de passe est vérifié en base
// par `validateModuleAuth` : il doit correspondre à l'entrée du module dans
// la table `modules` de la WebApp.
#define MC_MODULE_ID       "MC-0001-ST"
#define MC_MODULE_PASSWORD "<secret du module>"
#endif
